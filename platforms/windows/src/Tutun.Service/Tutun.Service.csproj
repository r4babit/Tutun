<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <!-- Номер версии — из файла VERSION в корне (как на маке). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\VERSION').Trim())</Version>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Tutun.Service</AssemblyName>
    <RootNamespace>Tutun.Service</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>..\Tutun.App\Assets\tutun.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Tutun.Core\Tutun.Core.csproj" />
  </ItemGroup>
</Project>
